[
    {
        "id": "tab_billing_main",
        "type": "tab",
        "label": "Integración Billing",
        "disabled": false,
        "info": "Demo de integración Node-RED <-> Sistema de Inventario y Facturación."
    },
    {
        "id": "ui_tab_billing",
        "type": "ui_tab",
        "name": "Billing",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "ui_group_kpis",
        "type": "ui_group",
        "name": "KPIs",
        "tab": "ui_tab_billing",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "inj_health",
        "type": "inject",
        "z": "tab_billing_main",
        "name": "Health cada 20s",
        "props": [{"p": "payload"}],
        "repeat": "20",
        "crontab": "",
        "once": true,
        "onceDelay": 1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 80,
        "wires": [["fn_health_req"]]
    },
    {
        "id": "fn_health_req",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Preparar health",
        "func": "msg.url = env.get('API_BASE') + '/health';\nmsg.method = 'GET';\nmsg.headers = {};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 130,
        "wires": [["http_health"]]
    },
    {
        "id": "http_health",
        "type": "http request",
        "z": "tab_billing_main",
        "name": "GET /health",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 380,
        "y": 80,
        "wires": [["fn_health_fmt"]]
    },
    {
        "id": "fn_health_fmt",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Formatear estado",
        "func": "const ok = msg.statusCode === 200;\nmsg.payload = ok\n  ? '🟢 API conectada — ' + new Date().toLocaleTimeString()\n  : '🔴 API sin respuesta (' + msg.statusCode + ')';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 80,
        "wires": [["ui_health", "dbg_health"]]
    },
    {
        "id": "ui_health",
        "type": "ui_text",
        "z": "tab_billing_main",
        "group": "ui_group_kpis",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Estado API",
        "label": "🌐 Conexión con el sistema",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "style": false,
        "font": "",
        "fontSize": "16",
        "color": "#000000",
        "x": 860,
        "y": 60,
        "wires": []
    },
    {
        "id": "dbg_health",
        "type": "debug",
        "z": "tab_billing_main",
        "name": "Health",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 860,
        "y": 100,
        "wires": []
    },
    {
        "id": "inj_kpi",
        "type": "inject",
        "z": "tab_billing_main",
        "name": "KPIs cada 30s",
        "props": [{"p": "payload"}],
        "repeat": "30",
        "crontab": "",
        "once": true,
        "onceDelay": 3,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 140,
        "y": 180,
        "wires": [["fn_kpi_login"]]
    },
    {
        "id": "fn_kpi_login",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Preparar login",
        "func": "msg.url = env.get('API_BASE') + '/auth/login';\nmsg.method = 'POST';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n  email: env.get('BILLING_EMAIL'),\n  password: env.get('BILLING_PASSWORD')\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 180,
        "wires": [["http_kpi_login"]]
    },
    {
        "id": "http_kpi_login",
        "type": "http request",
        "z": "tab_billing_main",
        "name": "POST /auth/login",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 620,
        "y": 180,
        "wires": [["fn_kpi_report"]]
    },
    {
        "id": "fn_kpi_report",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Guardar token y pedir dashboard",
        "func": "const token = msg.payload && msg.payload.data ? msg.payload.data.token : null;\nif (!token) {\n  node.error('Login fallo: ' + JSON.stringify(msg.payload), msg);\n  return [{ payload: '🔴 Login fallo. Revisa BILLING_EMAIL / BILLING_PASSWORD / API_BASE.' }, null];\n}\nflow.set('token', token);\nmsg.url = env.get('API_BASE') + '/reports/dashboard';\nmsg.method = 'GET';\nmsg.headers = { Authorization: 'Bearer ' + token };\nmsg.payload = null;\nreturn [null, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 180,
        "wires": [["dbg_kpi_error"], ["http_kpi_dash"]]
    },
    {
        "id": "dbg_kpi_error",
        "type": "debug",
        "z": "tab_billing_main",
        "name": "Error KPI",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 870,
        "y": 140,
        "wires": []
    },
    {
        "id": "http_kpi_dash",
        "type": "http request",
        "z": "tab_billing_main",
        "name": "GET /reports/dashboard",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 1120,
        "y": 180,
        "wires": [["fn_kpi_fmt"]]
    },
    {
        "id": "fn_kpi_fmt",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Preparar KPIs",
        "func": "msg.payload = (msg.payload && msg.payload.data) || {};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1350,
        "y": 180,
        "wires": [["ui_kpi_cards"]]
    },
    {
        "id": "ui_kpi_cards",
        "type": "ui_template",
        "z": "tab_billing_main",
        "group": "ui_group_kpis",
        "name": "Tarjetas KPI",
        "order": 2,
        "width": "12",
        "height": "0",
        "format": "<div class='kpi-grid'><div class='kpi-card'><div class='kpi-label'>📦 Productos</div><div class='kpi-value'>{{msg.payload.overview.totalProducts || 0}}</div></div><div class='kpi-card'><div class='kpi-label'>👥 Clientes</div><div class='kpi-value'>{{msg.payload.overview.totalCustomers || 0}}</div></div><div class='kpi-card'><div class='kpi-label'>🏭 Proveedores</div><div class='kpi-value'>{{msg.payload.overview.totalVendors || 0}}</div></div><div class='kpi-card danger'><div class='kpi-label'>⚠️ Stock bajo</div><div class='kpi-value'>{{msg.payload.overview.lowStockProductsCount || 0}}</div></div><div class='kpi-card'><div class='kpi-label'>🧾 Transacciones (mes)</div><div class='kpi-value'>{{msg.payload.monthly.transactionCount || 0}}</div></div><div class='kpi-card money'><div class='kpi-label'>💵 Ventas del mes (PEN)</div><div class='kpi-value'>{{msg.payload.monthly.sales || 0}}</div></div></div><style>.kpi-grid{display:flex;flex-wrap:wrap;gap:10px}.kpi-card{flex:1 1 150px;background:#f4f6f8;border-radius:10px;padding:12px 14px;border-left:5px solid #2e7d32;box-shadow:0 1px 3px rgba(0,0,0,.12)}.kpi-card.danger{border-left-color:#c62828}.kpi-card.money{border-left-color:#1565c0}.kpi-label{font-size:12px;color:#555;margin-bottom:6px}.kpi-value{font-size:26px;font-weight:700;color:#222}</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 1580,
        "y": 180,
        "wires": [[]]
    },
    {
        "id": "inj_ls",
        "type": "inject",
        "z": "tab_billing_main",
        "name": "Stock bajo cada 30s",
        "props": [{"p": "payload"}],
        "repeat": "30",
        "crontab": "",
        "once": true,
        "onceDelay": 10,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 170,
        "y": 280,
        "wires": [["fn_ls_req"]]
    },
    {
        "id": "fn_ls_req",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Preparar consulta",
        "func": "const token = flow.get('token');\nif (!token) {\n  node.status({ fill: 'red', shape: 'ring', text: 'sin token' });\n  return null;\n}\nnode.status({ fill: 'green', shape: 'dot', text: 'consultando' });\nmsg.url = env.get('API_BASE') + '/products/low-stock';\nmsg.method = 'GET';\nmsg.headers = { Authorization: 'Bearer ' + token };\nmsg.payload = null;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 280,
        "wires": [["http_ls"]]
    },
    {
        "id": "http_ls",
        "type": "http request",
        "z": "tab_billing_main",
        "name": "GET /products/low-stock",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 660,
        "y": 280,
        "wires": [["fn_ls_count"]]
    },
    {
        "id": "fn_ls_count",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Contar stock bajo",
        "func": "const d = (msg.payload && msg.payload.data) || {};\nconst items = d.products || d.lowStockProducts || [];\nmsg.count = items.length;\nmsg.items = items;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 280,
        "wires": [["fn_ls_alert"]]
    },
    {
        "id": "fn_ls_alert",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Armar alerta",
        "func": "const nl = String.fromCharCode(10);\nconst items = msg.items || [];\nif (items.length === 0) {\n  msg.payload = 'Sin productos con stock bajo.';\n  return msg;\n}\nconst lines = items.map(function (p) {\n  return '- ' + p.name + ' (stock ' + p.stock + ' / min ' + p.minStockLevel + ')';\n});\nmsg.payload = 'Alerta: ' + items.length + ' producto(s) con stock bajo:' + nl + lines.join(nl);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1330,
        "y": 280,
        "wires": [["ui_ls_text", "dbg_ls"]]
    },
    {
        "id": "ui_ls_text",
        "type": "ui_template",
        "z": "tab_billing_main",
        "group": "ui_group_kpis",
        "name": "Alertas de stock",
        "order": 3,
        "width": "12",
        "height": "6",
        "format": "<div style='background:#fff4f4;border-left:5px solid #c62828;border-radius:10px;padding:12px 14px;white-space:pre-line;font-size:14px;color:#7a1f1f;max-height:260px;overflow-y:auto'>{{msg.payload}}</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 1580,
        "y": 280,
        "wires": [[]]
    },
    {
        "id": "dbg_ls",
        "type": "debug",
        "z": "tab_billing_main",
        "name": "Stock bajo",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 1560,
        "y": 300,
        "wires": []
    },

    {
        "id": "in_hook",
        "type": "http in",
        "z": "tab_billing_main",
        "name": "Webhook del sistema",
        "url": "/webhook",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 180,
        "y": 380,
        "wires": [["fn_hook"]]
    },
    {
        "id": "fn_hook",
        "type": "function",
        "z": "tab_billing_main",
        "name": "Etiquetar evento",
        "func": "const body = msg.payload || {};\nmsg.event = body.event || 'unknown';\nmsg.payload = 'Evento: ' + msg.event;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 380,
        "wires": [["dbg_hook", "res_hook", "fn_kpi_login", "fn_ls_req"]]
    },
    {
        "id": "dbg_hook",
        "type": "debug",
        "z": "tab_billing_main",
        "name": "Evento del sistema",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 660,
        "y": 360,
        "wires": []
    },
    {
        "id": "res_hook",
        "type": "http response",
        "z": "tab_billing_main",
        "name": "200 OK",
        "statusCode": "200",
        "headers": {},
        "x": 660,
        "y": 400,
        "wires": []
    }
]


