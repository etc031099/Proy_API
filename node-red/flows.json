        "format": "<div class='kpi-grid'><div class='kpi-card'><div class='kpi-label'>📦 Productos</div><div class='kpi-value'>{{msg.payload.overview.totalProducts || 0}}</div></div><div class='kpi-card'><div class='kpi-label'>👥 Clientes</div><div class='kpi-value'>{{msg.payload.overview.totalCustomers || 0}}</div></div><div class='kpi-card'><div class='kpi-label'>🏭 Proveedores</div><div class='kpi-value'>{{msg.payload.overview.totalVendors || 0}}</div></div><div class='kpi-card danger'><div class='kpi-label'>⚠️ Stock bajo</div><div class='kpi-value'>{{msg.payload.overview.lowStockProductsCount || 0}}</div></div><div class='kpi-card'><div class='kpi-label'>🧾 Transacciones (mes)</div><div class='kpi-value'>{{msg.payload.monthly.transactionCount || 0}}</div></div><div class='kpi-card money'><div class='kpi-label'>💵 Ventas del mes (PEN)</div><div class='kpi-value'>{{(msg.payload.monthly.sales || 0) | number:2}}</div></div></div><style>.kpi-grid{display:flex;flex-wrap:wrap;gap:10px}.kpi-card{flex:1 1 150px;background:#f4f6f8;border-radius:10px;padding:12px 14px;border-left:5px solid #2e7d32;box-shadow:0 1px 3px rgba(0,0,0,.12)}.kpi-card.danger{border-left-color:#c62828}.kpi-card.money{border-left-color:#1565c0}.kpi-label{font-size:12px;color:#555;margin-bottom:6px}.kpi-value{font-size:26px;font-weight:700;color:#222}</style>",
