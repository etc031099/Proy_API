    {
        "id": "tg_tab",
        "type": "tab",
        "label": "Telegram Bot",
        "disabled": false,
        "info": "Bot de Telegram: /stock, /ventas, /deudas"
    },
    {
        "id": "tg_parse",
        "type": "function",
        "z": "tg_tab",
        "name": "Leer comando",
        "func": "const data = msg.data || {};\nmsg.chatId = data.chatId;\nconst text = String(data.text || '').trim();\nconst lower = text.toLowerCase();\nlet cmd = '';\nlet arg = '';\nif (lower.charAt(0) === '/') {\n  const lp = lower.split(' ').filter(function (s) { return s.length > 0; });\n  cmd = lp[0].substring(1).split('@')[0];\n  const rp = text.split(' ').filter(function (s) { return s.length > 0; });\n  arg = rp.slice(1).join(' ').trim();\n} else if (lower.indexOf('stock') >= 0 || lower.indexOf('inventario') >= 0) {\n  cmd = 'stock';\n} else if (lower.indexOf('venta') >= 0) {\n  cmd = 'ventas';\n} else if (lower.indexOf('deuda') >= 0 || lower.indexOf('saldo') >= 0) {\n  cmd = 'deudas';\n} else {\n  cmd = 'ayuda';\n}\nmsg.cmd = cmd || 'ayuda';\nmsg.arg = arg;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 200,
        "y": 120,
        "wires": [["tg_login_req"]]
    },
    {
        "id": "tg_login_req",
        "type": "function",
        "z": "tg_tab",
        "name": "Preparar login",
        "func": "msg.url = env.get('API_BASE') + '/auth/login';\nmsg.method = 'POST';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { email: env.get('BILLING_EMAIL'), password: env.get('BILLING_PASSWORD') };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 120,
        "wires": [["tg_login_http"]]
    },
    {
        "id": "tg_login_http",
        "type": "http request",
        "z": "tg_tab",
        "name": "POST /auth/login",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 640,
        "y": 120,
        "wires": [["tg_route"]]
    },
    {
        "id": "tg_route",
        "type": "function",
        "z": "tg_tab",
        "name": "Elegir consulta",
        "func": "const nl = String.fromCharCode(10);\nconst token = msg.payload && msg.payload.data ? msg.payload.data.token : null;\nif (!token) {\n  msg.tgText = 'No pude conectar con el sistema.';\n  return [null, msg];\n}\nconst base = env.get('API_BASE');\nmsg.headers = { Authorization: 'Bearer ' + token };\nmsg.method = 'GET';\nif (msg.cmd === 'stock') {\n  msg.url = msg.arg ? base + '/products?limit=10&search=' + encodeURIComponent(msg.arg) : base + '/products/low-stock';\n} else if (msg.cmd === 'ventas') {\n  msg.url = base + '/transactions?type=sale&limit=50';\n} else if (msg.cmd === 'deudas') {\n  msg.url = base + '/contacts/customers?limit=100';\n} else {\n  msg.tgText = 'Elige una opcion en los botones o escribe:' + nl + '/stock <producto>' + nl + '/ventas' + nl + '/deudas';\n  return [null, msg];\n}\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 120,
        "wires": [["tg_api_http"], ["tg_send"]]
    },
    {
        "id": "tg_api_http",
        "type": "http request",
        "z": "tg_tab",
        "name": "Consultar sistema",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 1090,
        "y": 100,
        "wires": [["tg_reply"]]
    },
    {
        "id": "tg_reply",
        "type": "function",
        "z": "tg_tab",
        "name": "Armar respuesta",
        "func": "const nl = String.fromCharCode(10);\nconst d = (msg.payload && msg.payload.data) || {};\nif (msg.cmd === 'stock') {\n  const list = d.products || d.lowStockProducts || [];\n  const title = msg.arg ? 'Resultado:' : 'Productos con stock bajo:';\n  msg.tgText = list.length === 0 ? (msg.arg ? 'No encontre productos con ese nombre.' : 'No hay productos con stock bajo.') : title + nl + list.map(function (p) { return '- ' + p.name + ': ' + p.stock + ' (min ' + p.minStockLevel + ')'; }).join(nl);\n} else if (msg.cmd === 'ventas') {\n  const list = d.transactions || [];\n  const today = new Date().toISOString().slice(0, 10);\n  const hoy = list.filter(function (t) { return String(t.date || '').slice(0, 10) === today; });\n  let total = 0;\n  hoy.forEach(function (t) { total += Number(t.totalAmount) || 0; });\n  total = Math.round(total * 100) / 100;\n  msg.tgText = 'Ventas de hoy: ' + hoy.length + nl + 'Total: S/ ' + total;\n} else if (msg.cmd === 'deudas') {\n  const list = d.customers || [];\n  const deudores = list.filter(function (c) { return (Number(c.currentBalance) || 0) > 0; });\n  msg.tgText = deudores.length === 0 ? 'No hay clientes con deuda pendiente.' : 'Clientes con deuda:' + nl + deudores.map(function (c) { return '- ' + c.name + ': S/ ' + (Math.round((Number(c.currentBalance) || 0) * 100) / 100); }).join(nl);\n} else {\n  msg.tgText = 'Elige una opcion en los botones o escribe:' + nl + '/stock <producto>' + nl + '/ventas' + nl + '/deudas';\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1330,
        "y": 100,
        "wires": [["tg_send"]]
    },
    {
        "id": "tg_send",
        "type": "function",
        "z": "tg_tab",
        "name": "Preparar respuesta Telegram",
