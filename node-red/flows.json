        "func": "msg.payload = (msg.payload && msg.payload.data) || {};\nif (msg.payload.monthly) {\n  msg.payload.monthly.sales = Math.round((Number(msg.payload.monthly.sales) || 0) * 100) / 100;\n  msg.payload.monthly.purchases = Math.round((Number(msg.payload.monthly.purchases) || 0) * 100) / 100;\n  msg.payload.monthly.profit = Math.round((Number(msg.payload.monthly.profit) || 0) * 100) / 100;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
