# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Docker replica set: rs0)
# Required by Docker Compose. Set real local values only in backend/.env.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGODB_REPLICA_SET=rs0

# Backend running on the host, MongoDB running in Docker
MONGODB_URI=

# Backend running as the `api` Docker Compose service
MONGODB_URI_DOCKER=

# Dedicated database used only by real MongoDB integration tests
MONGODB_TEST_URI=

# For MongoDB Atlas, replace the URI and leave MONGODB_REPLICA_SET unset unless
# it matches the replica-set name reported by Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventory_billing

# JWT Configuration (required, random, at least 32 characters)
JWT_SECRET=
JWT_EXPIRE=7d

# Business Configuration
DEFAULT_BUSINESS_ID=default_business_123

# Telegram Bot API (keep this value private)
TELEGRAM_BOT_TOKEN=

# Optional: Node-RED / automation integration (leave empty to disable)
# When set, the backend POSTs events (transaction.created, product.low_stock, ...) to this URL.
NODE_RED_WEBHOOK_URL=
# Required when NODE_RED_WEBHOOK_URL is set. Use the same random value in Node-RED
# (at least 32 characters; never commit the real value).
NODE_RED_WEBHOOK_SECRET=
