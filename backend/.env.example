# Server Configuration
PORT=5000
NODE_ENV=development

# Exact browser origins, comma-separated. Spaces around entries are ignored.
# Wildcards are forbidden; production requires an explicit non-empty value.
# Development example: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Database Configuration (Docker replica set: rs0)
# Required by Docker Compose. Set real local values only in backend/.env.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGODB_REPLICA_SET=rs0

# Backend running on the host, MongoDB running in Docker
MONGODB_URI=

# Backend running as the `api` Docker Compose service
MONGODB_URI_DOCKER=

# Dedicated database used only by real MongoDB integration tests
MONGODB_TEST_URI=

# For MongoDB Atlas, replace the URI and leave MONGODB_REPLICA_SET unset unless
# it matches the replica-set name reported by Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventory_billing

# JWT Configuration (required, random, at least 32 characters)
JWT_SECRET=
JWT_EXPIRE=7d

# Business Configuration
DEFAULT_BUSINESS_ID=default_business_123

# Temporary V2 provisioning: requires an authenticated V1 owner and this email.
# Keep disabled except while creating the single V2 account. Never set NEXT_PUBLIC_*.
DEMO_V2_REGISTRATION_ENABLED=false
DEMO_V2_REGISTRATION_EMAIL=

# Telegram Bot API (keep this value private)
TELEGRAM_BOT_TOKEN=

# Optional: Node-RED / automation integration (leave empty to disable)
# When set, the backend POSTs events (transaction.created, product.low_stock, ...) to this URL.
NODE_RED_WEBHOOK_URL=
# Required when NODE_RED_WEBHOOK_URL is set. Use the same random value in Node-RED
# (at least 32 characters; never commit the real value).
NODE_RED_WEBHOOK_SECRET=
# Optional bounded outbox dispatcher entrypoint; separate random secret (32+ chars).
# Leave empty until an authenticated external recovery trigger is configured.
INVENTORY_ALERT_DISPATCH_SECRET=

# Optional demand-forecast ML integration. When enabled, both URL and secret
# are required. Keep the secret backend-only and use at least 32 characters.
ML_ENABLED=false
ML_SERVICE_URL=
ML_SERVICE_SECRET=

# Optional multi-agent Gemini provider. Keep the API key in server secrets only.
AGENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
